# Redis Cloud (get connection details from https://cloud.redis.io)
# Format: redis://default:<password>@<host>:<port>
# For TLS (Redis Cloud): rediss://default:<password>@<host>:<port>
REDIS_URL=rediss://default:your-password@your-host.redis.cloud:your-port

# If your Redis Cloud uses separate username/password (optional, usually in URL)
# REDIS_USERNAME=default
# REDIS_PASSWORD=your-password

# OpenAI API Key (required for embeddings + entity extraction)
OPENAI_API_KEY=sk-your-key-here

# TinyFish Web Agent (required - fetches full post content from URLs)
# Get your key at: https://agent.tinyfish.ai/dashboard
TINYFISH_API_KEY=your-tinyfish-api-key

# Server
PORT=3456
